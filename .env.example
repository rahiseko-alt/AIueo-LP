# Vercel Native Neon integration injects DATABASE_URL and NEON_AUTH_BASE_URL.
# Use DATABASE_URL_UNPOOLED only for migrations; never expose either value in a client bundle.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Server-only operational secrets. Never prefix these with NEXT_PUBLIC_ or commit values.
CRON_SECRET=
